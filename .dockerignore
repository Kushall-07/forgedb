# Version control and docs: never needed to compile the binary.
.git
.gitignore
*.md
docs/

# Generated/data artifacts: not source, and some can be large.
benchmark/results/
coverage/
coverage.out
*.coverprofile
*.log
data/
tmp/

# Editor/IDE metadata.
.vscode/
.idea/
.DS_Store

# Local Docker artifacts never need to be in their own build context.
docker-compose.yml
deploy/scripts/

# Secrets: a local .env (see .gitignore) must never enter the build
# context -- Dockerfile's builder stage does `COPY . .`, so without this
# exclusion a real FORGEDB_API_TOKEN would land inside the builder
# image's own layer even though the final runtime stage never COPYs it
# from there. .env.example is a placeholder, not a secret, and is
# deliberately not excluded here.
.env
