# Example environment file for `docker compose` (see docker-compose.yml's
# FORGEDB_API_TOKEN entry). Copy this to a local, untracked `.env` and
# replace the value below -- NEVER commit a real token.
#
#   cp .env.example .env
#
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
#
# This is only an example value and must not be used as-is in any real
# deployment.
FORGEDB_API_TOKEN=replace-with-a-secret

# Optional: the address forge-gateway (the leader-aware public HTTP
# entrypoint -- see docker-compose.yml's forge-gateway service and
# docs/deployment/phase15-leader-aware-gateway.md) listens on inside its
# container. Not a secret; docker-compose.yml already sets a working
# default (0.0.0.0:8090) for the bundled deployment, so this is only
# needed if you want to override it.
# GATEWAY_ADDR=0.0.0.0:8090
