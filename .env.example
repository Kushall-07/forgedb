# Example environment file for `docker compose` (see docker-compose.yml's
# FORGEDB_API_TOKEN entry). Copy this to a local, untracked `.env` and
# replace the value below -- NEVER commit a real token.
#
#   cp .env.example .env
#
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
#
# This is only an example value and must not be used as-is in any real
# deployment.
FORGEDB_API_TOKEN=replace-with-a-secret
