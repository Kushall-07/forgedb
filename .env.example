# Example environment file for `docker compose` (see docker-compose.yml's
# FORGEDB_API_TOKEN entry). Copy this to a local, untracked `.env` and
# replace the value below -- NEVER commit a real token.
#
#   cp .env.example .env
#
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
#
# This is only an example value and must not be used as-is in any real
# deployment.
FORGEDB_API_TOKEN=replace-with-a-secret

# Optional: the address forge-gateway (the leader-aware public HTTP
# entrypoint -- see docker-compose.yml's forge-gateway service and
# docs/deployment/phase15-leader-aware-gateway.md) listens on inside its
# container. Not a secret; docker-compose.yml already sets a working
# default (0.0.0.0:8090) for the bundled deployment, so this is only
# needed if you want to override it.
# GATEWAY_ADDR=0.0.0.0:8090

# Optional: a comma-separated list of exact browser Origins allowed to
# read a cross-origin response from a node's HTTP API (see
# internal/api/cors.go and docs/deployment/phase13-hardening.md). Only
# needed when the dashboard is served from a different origin than the
# public API edge (e.g. a separate Vercel domain) -- the default, when
# unset, is "no origin allowed" (CORS disabled), exactly as before
# Phase 13. Set this to your own deployed dashboard's real domain and/or
# your local dev server; NEVER commit a real deployment's actual value
# here, and never put a temporary Cloudflare Quick Tunnel
# (*.trycloudflare.com) hostname in any tracked file -- it changes every
# time the tunnel restarts and is not a stable production origin.
#
#   FORGEDB_CORS_ORIGINS=https://<your-dashboard-domain>,http://localhost:5173
#
# GATEWAY_MAX_BODY_BYTES and MAX_VALUE_BYTES override the gateway's and
# a node's existing request-size limits (defaults: 4 MiB / 1 MiB
# respectively -- see internal/gateway.DefaultMaxBodyBytes /
# internal/api.DefaultMaxValueBytes). Most deployments never need to set
# these; they exist so the limit is tunable without a code change.
# GATEWAY_MAX_BODY_BYTES=4194304
# MAX_VALUE_BYTES=1048576
