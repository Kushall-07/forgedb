# Example environment file for Caddy's systemd service, providing the
# FORGEDB_PUBLIC_HOSTNAME value deploy/Caddyfile.example's site label
# substitutes at startup (Caddy's own {$VAR} placeholder syntax -- see
# that file's comments). Caddy runs natively on the Azure VM (not in
# Docker Compose; see docker-compose.yml), so this is a plain systemd
# EnvironmentFile, not a docker-compose .env -- see deploy/README.md's
# HTTPS section for the full setup.
#
#   sudo cp deploy/caddy.env.example /etc/caddy/caddy.env
#   sudo $EDITOR /etc/caddy/caddy.env   # replace the placeholder below
#   sudo systemctl edit caddy
#     # paste into the override file systemctl opens:
#     [Service]
#     EnvironmentFile=/etc/caddy/caddy.env
#   sudo systemctl daemon-reload
#   sudo systemctl restart caddy
#
# Do not commit a copy of this file with your real hostname filled in --
# only this placeholder is tracked. A hostname is not as sensitive as
# FORGEDB_API_TOKEN, but keeping it out of tracked files avoids baking a
# specific deployment's address into the repository, same principle as
# .env.example's own note on FORGEDB_API_TOKEN.
FORGEDB_PUBLIC_HOSTNAME=your-stable-hostname.example.com
